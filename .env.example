DISCORD_BOT_TOKEN=
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token

# Initial prefix for legacy commands, such as !code or ?code.
# The !prefix command changes it at runtime only; changes are not persisted.
DISCORD_PREFIX=!

# Optional: set this to a specific guild/server ID so slash commands appear immediately there.
DISCORD_GUILD_ID=

# Discord user IDs allowed to use the coding agent.
# Multiple IDs can be separated by commas.
ALLOWED_USER_IDS=your_discord_user_id

# OpenCode server
OPENCODE_URL=http://127.0.0.1:4096

# Absolute path passed to OpenCode as the working directory.
OPENCODE_WORKSPACE=/home/your-user/ai-workspace/projects
